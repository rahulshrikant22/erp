// SECTION 8 — Payment Foundation (3 tables)
// =============================================================================

model PaymentGateway {
  id              String   @id @default(uuid())
  gatewayCode     String   @unique @map("gateway_code") // razorpay | stripe | ...
  displayName     String   @map("display_name")
  configuration   Json     // @encrypted
  isTestMode      Boolean  @default(true) @map("is_test_mode")
  isPrimary       Boolean  @default(false) @map("is_primary")
  isActive        Boolean  @default(true) @map("is_active")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdById     String?  @map("created_by_id")
  updatedById     String?  @map("updated_by_id")

  transactions    PaymentTransaction[]

  @@index([isActive])
  @@index([isPrimary])
  @@map("payment_gateways")
  @@schema("core")
}

model PaymentTransaction {
  id                    String    @id @default(uuid())
  transactionCode       String    @unique @map("transaction_code")
  gatewayId             String?   @map("gateway_id")
  paymentMode           String    @map("payment_mode") // online | bank_transfer | cheque | cash
  relatedEntityType     String?   @map("related_entity_type")
  relatedEntityId       String?   @map("related_entity_id")
  amount                Decimal   @db.Decimal(18, 2)
  currency              String    @default("INR")
  status                String    @default("initiated") // initiated | pending | success | failed | refunded
  gatewayTransactionId  String?   @map("gateway_transaction_id")
  gatewayPaymentId      String?   @map("gateway_payment_id")
  utrNumber             String?   @map("utr_number")
  chequeNumber          String?   @map("cheque_number")
  chequeDate            DateTime? @map("cheque_date") @db.Date
  payerName             String?   @map("payer_name")
  notes                 String?

  initiatedAt           DateTime  @default(now()) @map("initiated_at")
  completedAt           DateTime? @map("completed_at")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  createdById           String?   @map("created_by_id")
  updatedById           String?   @map("updated_by_id")

  gateway               PaymentGateway? @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  refunds               PaymentRefund[]

  @@index([gatewayId])
  @@index([paymentMode])
  @@index([status])
  @@index([relatedEntityType, relatedEntityId])
  @@map("payment_transactions")
  @@schema("core")
}

model PaymentRefund {
  id                  String    @id @default(uuid())
  refundCode          String    @unique @map("refund_code")
  transactionId       String    @map("transaction_id")
  amount              Decimal   @db.Decimal(18, 2)
  currency            String    @default("INR")
  reason              String?
  status              String    @default("initiated") // initiated | pending | success | failed
  gatewayRefundId     String?   @map("gateway_refund_id")
  initiatedAt         DateTime  @default(now()) @map("initiated_at")
  completedAt         DateTime? @map("completed_at")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdById         String?   @map("created_by_id")
  updatedById         String?   @map("updated_by_id")

  transaction         PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([status])
  @@map("payment_refunds")
  @@schema("core")
}

// =============================================================================
// SECTION 9 — Documents / Numbering / Settings (3 tables)
// =============================================================================

model Document {
  id                  String    @id @default(uuid())
  documentType        String    @map("document_type")
  name                String
  filePath            String    @map("file_path")
  fileSize            BigInt?   @map("file_size")
  mimeType            String?   @map("mime_type")
  relatedEntityType   String?   @map("related_entity_type")
  relatedEntityId     String?   @map("related_entity_id")
  uploadedById        String?   @map("uploaded_by_id")
  uploadedAt          DateTime  @default(now()) @map("uploaded_at")
  version             Int       @default(1)
  parentDocumentId    String?   @map("parent_document_id")
  // Soft delete (P0-12). The physical file is intentionally NOT removed —
  // we keep it for audit / regulatory recovery. The flag just hides the row
  // from normal lists and downloads.
  isDeleted           Boolean   @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at")
  deletedById         String?   @map("deleted_by_id")

  parent              Document?  @relation("DocumentVersions", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  versions            Document[] @relation("DocumentVersions")

  @@index([documentType])
  @@index([relatedEntityType, relatedEntityId])
  @@index([parentDocumentId])
  @@index([isDeleted])
  @@map("documents")
  @@schema("core")
}

model NumberingSeries {
  id              String    @id @default(uuid())
  seriesCode      String    @unique @map("series_code") // ORD | INV | PO | GRN | ...
  name            String
  prefix          String?
  yearFormat      String    @default("YYYY") @map("year_format") // YYYY | YY | none
  separator       String    @default("/")
  paddingLength   Int       @default(4) @map("padding_length")
  currentNumber   Int       @default(0) @map("current_number")
  resetYearly     Boolean   @default(true) @map("reset_yearly")
  lastResetAt     DateTime? @map("last_reset_at")
  isActive        Boolean   @default(true) @map("is_active")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdById     String?   @map("created_by_id")
  updatedById     String?   @map("updated_by_id")

  @@index([isActive])
  @@map("numbering_series")
  @@schema("core")
}

model SystemSetting {
  id              String    @id @default(uuid())
  settingKey      String    @unique @map("setting_key")
  settingValue    String?   @map("setting_value") @db.Text
  dataType        String    @map("data_type") // string | integer | boolean | json
  category        String?
  description     String?
  isUserEditable  Boolean   @default(true) @map("is_user_editable")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdById     String?   @map("created_by_id")
  updatedById     String?   @map("updated_by_id")

  @@index([category])
  @@map("system_settings")
  @@schema("core")
}

// =============================================================================
// SECTION — SALES SCHEMA (Phase 1 — 23 Tables)
// =============================================================================

// -- Customer Master (4 tables) -----------------------------------------------

model Customer {
  id                        String    @id @default(uuid())
  customerCode              String    @unique @map("customer_code")
  customerName              String    @map("customer_name")
  legalName                 String?   @map("legal_name")
  customerType              String    @map("customer_type") // retail | dealer | architect | interior_designer | corporate
  gstin                     String?
  pan                       String?
  primaryPhone              String?   @map("primary_phone")
  primaryEmail              String?   @map("primary_email")
  defaultBillingAddressId   String?   @map("default_billing_address_id")
  defaultShippingAddressId  String?   @map("default_shipping_address_id")
  creditLimit               Decimal?  @map("credit_limit") @db.Decimal(14, 2)
  creditDays                Int?      @map("credit_days")
  paymentTermsTemplateId    String?   @map("payment_terms_template_id")
  bankName                  String?   @map("bank_name")
  bankAccountNumber         String?   @map("bank_account_number")
  bankIfsc                  String?   @map("bank_ifsc")
  isActive                  Boolean   @default(true) @map("is_active")
  isBlacklisted             Boolean   @default(false) @map("is_blacklisted")
  notes                     String?   @db.Text
  source                    String    @default("manual") // manual | csv_import | portal
  linkedCustomerAccountId   String?   @map("linked_customer_account_id")

  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  createdById               String?   @map("created_by_id")
  updatedById               String?   @map("updated_by_id")
  isDeleted                 Boolean   @default(false) @map("is_deleted")
  deletedAt                 DateTime? @map("deleted_at")
  deletedById               String?   @map("deleted_by_id")

  addresses                 CustomerAddress[]
  contacts                  CustomerContact[]
  tierPricing               CustomerTierPricing[]
  orders                    Order[]
  paymentTermsTemplate      PaymentTermsTemplate? @relation(fields: [paymentTermsTemplateId], references: [id], onDelete: SetNull)

  @@index([customerType])
  @@index([isActive])
  @@index([isDeleted])
  @@index([linkedCustomerAccountId])
  @@index([paymentTermsTemplateId])
  @@map("customers")
  @@schema("sales")
}

model CustomerAddress {
  id                  String    @id @default(uuid())
  customerId          String    @map("customer_id")
  addressType         String    @map("address_type") // billing | shipping | site | registered
  contactPerson       String?   @map("contact_person")
  contactPhone        String?   @map("contact_phone")
  addressLine1        String    @map("address_line_1")
  addressLine2        String?   @map("address_line_2")
  city                String
  state               String
  stateCode           String?   @map("state_code") // 2-digit GST state code
  pincode             String
  country             String    @default("India")
  isDefaultBilling    Boolean   @default(false) @map("is_default_billing")
  isDefaultShipping   Boolean   @default(false) @map("is_default_shipping")
  notes               String?   @db.Text

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  billingOrders       Order[]   @relation("OrderBillingAddress")
  shippingOrders      Order[]   @relation("OrderShippingAddress")
  shipments           OrderShipment[]

  @@index([customerId])
  @@index([addressType])
  @@map("customer_addresses")
  @@schema("sales")
}

model CustomerContact {
  id              String    @id @default(uuid())
  customerId      String    @map("customer_id")
  contactName     String    @map("contact_name")
  designation     String?
  phone           String?
  email           String?
  role            String?   // decision_maker | purchase | accounts | site_contact
  isPrimary       Boolean   @default(false) @map("is_primary")
  notes           String?   @db.Text

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
  @@schema("sales")
}

model CustomerTierPricing {
  id                  String    @id @default(uuid())
  customerId          String    @map("customer_id")
  productId           String?   @map("product_id")
  productCategoryId   String?   @map("product_category_id")
  discountPercent     Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  specialPrice        Decimal?  @map("special_price") @db.Decimal(14, 2)
  validFrom           DateTime? @map("valid_from")
  validUntil          DateTime? @map("valid_until")
  notes               String?   @db.Text

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  customer            Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product             Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCategory     ProductCategory? @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([productId])
  @@index([productCategoryId])
  @@map("customer_tier_pricing")
  @@schema("sales")
}

// -- Product Master (4 tables) ------------------------------------------------

model ProductCategory {
  id                  String    @id @default(uuid())
  categoryCode        String    @unique @map("category_code")
  name                String
  parentCategoryId    String?   @map("parent_category_id")
  description         String?   @db.Text
  displayOrder        Int       @default(0) @map("display_order")
  isActive            Boolean   @default(true) @map("is_active")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdById         String?   @map("created_by_id")
  updatedById         String?   @map("updated_by_id")

  parent              ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children            ProductCategory[] @relation("CategoryHierarchy")
  products            Product[]
  customerTierPricing CustomerTierPricing[]

  @@index([parentCategoryId])
  @@index([isActive])
  @@map("product_categories")
  @@schema("sales")
}

model Product {
  id                      String    @id @default(uuid())
  productCode             String    @unique @map("product_code")
  productName             String    @map("product_name")
  categoryId              String    @map("category_id")
  description             String?   @db.Text
  standardDimensions      Json?     @map("standard_dimensions") // { L, W, H, D }
  hsnCode                 String?   @map("hsn_code")
  basePrice               Decimal   @map("base_price") @db.Decimal(14, 2)
  uom                     String    @default("PCS") // unit of measure code
  taxRatePercent          Decimal   @map("tax_rate_percent") @db.Decimal(5, 2)
  requiresInstallation    Boolean   @default(false) @map("requires_installation")
  warrantyPeriodMonths    Int?      @map("warranty_period_months")
  weightKg                Decimal?  @map("weight_kg") @db.Decimal(10, 3)
  imageUrl                String?   @map("image_url")
  isCustom                Boolean   @default(false) @map("is_custom")
  isActive                Boolean   @default(true) @map("is_active")
  bomId                   String?   @map("bom_id") // Phase 2 — stays null

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  createdById             String?   @map("created_by_id")
  updatedById             String?   @map("updated_by_id")
  isDeleted               Boolean   @default(false) @map("is_deleted")
  deletedAt               DateTime? @map("deleted_at")
  deletedById             String?   @map("deleted_by_id")

  category                ProductCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sizeVariants            ProductSizeVariant[]
  tierPricing             ProductTierPricing[]
  customerTierPricing     CustomerTierPricing[]
  orderLines              OrderLine[]
  boms                    Bom[]

  @@index([categoryId])
  @@index([hsnCode])
  @@index([isActive])
  @@index([isDeleted])
  @@index([isCustom])
  @@map("products")
  @@schema("sales")
}

model ProductSizeVariant {
  id              String    @id @default(uuid())
  productId       String    @map("product_id")
  variantName     String    @map("variant_name")
  dimensions      Json?     // { L, W, H, D }
  variantSku      String?   @map("variant_sku")
  priceOverride   Decimal?  @map("price_override") @db.Decimal(14, 2)
  weightKg        Decimal?  @map("weight_kg") @db.Decimal(10, 3)
  isActive        Boolean   @default(true) @map("is_active")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderLines      OrderLine[]
  boms            Bom[]

  @@index([productId])
  @@map("product_size_variants")
  @@schema("sales")
}

model ProductTierPricing {
  id              String    @id @default(uuid())
  productId       String    @map("product_id")
  customerType    String    @map("customer_type") // retail | dealer | architect | interior_designer | corporate
  discountPercent Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  fixedPrice      Decimal?  @map("fixed_price") @db.Decimal(14, 2)
  validFrom       DateTime? @map("valid_from")
  validUntil      DateTime? @map("valid_until")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([customerType])
  @@map("product_tier_pricing")
  @@schema("sales")
}

// -- Order Management (12 tables) ---------------------------------------------

model Order {
  id                        String    @id @default(uuid())
  orderNumber               String    @unique @map("order_number")
  customerId                String    @map("customer_id")
  orderDate                 DateTime  @map("order_date") @db.Date
  orderType                 String    @default("regular") @map("order_type") // regular | sample | replacement
  source                    String    @default("manual") // manual | csv_import | portal | quote_conversion
  sourceQuoteId             String?   @map("source_quote_id") // Phase 6
  sourceQuoteVersionId      String?   @map("source_quote_version_id") // Phase 6
  billingAddressId          String?   @map("billing_address_id")
  defaultShippingAddressId  String?   @map("default_shipping_address_id")
  expectedDeliveryDate      DateTime? @map("expected_delivery_date") @db.Date
  promisedDeliveryDate      DateTime? @map("promised_delivery_date") @db.Date
  paymentTermsTemplateId    String?   @map("payment_terms_template_id")
  status                    String    @default("draft") // draft | confirmed | in_production | ready_for_dispatch | dispatched | delivered | installed | completed | cancelled
  subtotal                  Decimal   @default(0) @db.Decimal(14, 2)
  totalDiscount             Decimal   @default(0) @map("total_discount") @db.Decimal(14, 2)
  taxableValue              Decimal   @default(0) @map("taxable_value") @db.Decimal(14, 2)
  totalTax                  Decimal   @default(0) @map("total_tax") @db.Decimal(14, 2)
  totalCharges              Decimal   @default(0) @map("total_charges") @db.Decimal(14, 2)
  grandTotal                Decimal   @default(0) @map("grand_total") @db.Decimal(14, 2)
  amountPaid                Decimal   @default(0) @map("amount_paid") @db.Decimal(14, 2)
  amountDue                 Decimal   @default(0) @map("amount_due") @db.Decimal(14, 2)
  roundOffAmount            Decimal   @default(0) @map("round_off_amount") @db.Decimal(8, 2)
  placeOfSupplyStateCode    String?   @map("place_of_supply_state_code")
  isInterstate              Boolean   @default(false) @map("is_interstate")
  actualMaterialCost        Decimal?  @map("actual_material_cost") @db.Decimal(14, 2) // Phase 4
  notes                     String?   @db.Text
  internalNotes             String?   @map("internal_notes") @db.Text
  createdBy                 String?   @map("created_by")
  confirmedBy               String?   @map("confirmed_by")
  confirmedAt               DateTime? @map("confirmed_at")

  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  updatedById               String?   @map("updated_by_id")
  isDeleted                 Boolean   @default(false) @map("is_deleted")
  deletedAt                 DateTime? @map("deleted_at")
  deletedById               String?   @map("deleted_by_id")

  customer                  Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  billingAddress            CustomerAddress?  @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  shippingAddress           CustomerAddress?  @relation("OrderShippingAddress", fields: [defaultShippingAddressId], references: [id], onDelete: SetNull)
  paymentTermsTemplate      PaymentTermsTemplate? @relation(fields: [paymentTermsTemplateId], references: [id], onDelete: SetNull)
  lines                     OrderLine[]
  shipments                 OrderShipment[]
  paymentSchedule           OrderPaymentSchedule[]
  documents                 OrderDocument[]
  statusHistory             OrderStatusHistory[]
  charges                   OrderCharge[]
  taxBreakup                OrderTaxBreakup[]
  selectionLists            SelectionList[]
  resolvedBoms              ResolvedBom[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@index([source])
  @@index([isDeleted])
  @@index([paymentTermsTemplateId])
  @@map("orders")
  @@schema("sales")
}

model OrderLine {
  id                        String    @id @default(uuid())
  orderId                   String    @map("order_id")
  lineSequence              Int       @map("line_sequence")
  lineType                  String    @map("line_type") // catalog_product | custom_item | charge_line
  productId                 String?   @map("product_id")
  productSizeVariantId      String?   @map("product_size_variant_id")
  description               String?   @db.Text
  quantity                  Decimal   @db.Decimal(10, 3)
  uom                       String    @default("PCS")
  unitPriceBeforeDiscount   Decimal   @default(0) @map("unit_price_before_discount") @db.Decimal(14, 2)
  discountType              String    @default("none") @map("discount_type") // none | percent | amount
  discountValue             Decimal   @default(0) @map("discount_value") @db.Decimal(14, 2)
  unitPriceFinal            Decimal   @default(0) @map("unit_price_final") @db.Decimal(14, 2)
  lineSubtotal              Decimal   @default(0) @map("line_subtotal") @db.Decimal(14, 2)
  hsnCode                   String?   @map("hsn_code")
  taxRatePercent            Decimal   @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  cgstAmount                Decimal   @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount                Decimal   @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount                Decimal   @default(0) @map("igst_amount") @db.Decimal(14, 2)
  lineTaxTotal              Decimal   @default(0) @map("line_tax_total") @db.Decimal(14, 2)
  lineGrandTotal            Decimal   @default(0) @map("line_grand_total") @db.Decimal(14, 2)
  customDimensions          Json?     @map("custom_dimensions") // for custom-size orders
  priceSource               String?   @map("price_source") // manual_override | customer_tier | customer_type_tier | size_variant | base_price
  bomResolved               Boolean   @default(false) @map("bom_resolved") // Phase 2
  notes                     String?   @db.Text

  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  order                     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                   Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  sizeVariant               ProductSizeVariant? @relation(fields: [productSizeVariantId], references: [id], onDelete: SetNull)
  customSpecs               OrderLineCustomSpec[]
  shipmentLines             OrderShipmentLine[]
  selectionListItems        SelectionListItem[]
  resolvedBoms              ResolvedBom[]

  @@index([orderId])
  @@index([productId])
  @@index([productSizeVariantId])
  @@map("order_lines")
  @@schema("sales")
}

model OrderLineCustomSpec {
  id              String    @id @default(uuid())
  orderLineId     String    @map("order_line_id")
  specKey         String    @map("spec_key")
  specValue       String    @map("spec_value")
  specType        String    @default("other") @map("spec_type") // dimension | finish | material | other
  notes           String?   @db.Text

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  orderLine       OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([orderLineId])
  @@map("order_line_custom_specs")
  @@schema("sales")
}

model OrderShipment {
  id                    String    @id @default(uuid())
  orderId               String    @map("order_id")
  shipmentNumber        String    @map("shipment_number")
  shippingAddressId     String?   @map("shipping_address_id")
  expectedDispatchDate  DateTime? @map("expected_dispatch_date") @db.Date
  status                String    @default("planned") // planned | ready | dispatched | delivered
  notes                 String?   @db.Text

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingAddress       CustomerAddress?  @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shipmentLines         OrderShipmentLine[]

  @@unique([orderId, shipmentNumber])
  @@index([orderId])
  @@index([status])
  @@map("order_shipments")
  @@schema("sales")
}

model OrderShipmentLine {
  id                  String    @id @default(uuid())
  shipmentId          String    @map("shipment_id")
  orderLineId         String    @map("order_line_id")
  quantityInShipment  Decimal   @map("quantity_in_shipment") @db.Decimal(10, 3)

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  shipment            OrderShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderLine           OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([orderLineId])
  @@map("order_shipment_lines")
  @@schema("sales")
}

model PaymentTermsTemplate {
  id              String    @id @default(uuid())
  templateCode    String    @unique @map("template_code")
  templateName    String    @map("template_name")
  description     String?   @db.Text
  isActive        Boolean   @default(true) @map("is_active")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdById     String?   @map("created_by_id")
  updatedById     String?   @map("updated_by_id")

  milestones      PaymentTermMilestone[]
  customers       Customer[]
  orders          Order[]
  vendors         Vendor[]

  @@index([isActive])
  @@map("payment_terms_templates")
  @@schema("sales")
}

model PaymentTermMilestone {
  id                  String    @id @default(uuid())
  templateId          String    @map("template_id")
  milestoneSequence   Int       @map("milestone_sequence")
  milestoneName       String    @map("milestone_name")
  percentage          Decimal   @db.Decimal(5, 2)
  triggerEvent        String    @map("trigger_event") // on_order | before_dispatch | on_delivery | after_installation | fixed_days
  triggerDays         Int?      @map("trigger_days")
  notes               String?   @db.Text

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  template            PaymentTermsTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, milestoneSequence])
  @@index([templateId])
  @@map("payment_term_milestones")
  @@schema("sales")
}

model OrderPaymentSchedule {
  id                      String    @id @default(uuid())
  orderId                 String    @map("order_id")
  milestoneSequence       Int       @map("milestone_sequence")
  milestoneName           String    @map("milestone_name")
  percentage              Decimal   @db.Decimal(5, 2)
  amount                  Decimal   @db.Decimal(14, 2)
  triggerEvent            String    @map("trigger_event")
  triggerDays             Int?      @map("trigger_days")
  dueDate                 DateTime? @map("due_date") @db.Date
  status                  String    @default("pending") // pending | partial | paid | overdue
  amountPaid              Decimal   @default(0) @map("amount_paid") @db.Decimal(14, 2)
  paidAt                  DateTime? @map("paid_at")
  paymentTransactionId    String?   @map("payment_transaction_id")
  notes                   String?   @db.Text

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  order                   Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, milestoneSequence])
  @@index([orderId])
  @@index([status])
  @@map("order_payment_schedule")
  @@schema("sales")
}

model OrderDocument {
  id                String    @id @default(uuid())
  orderId           String    @map("order_id")
  documentType      String    @map("document_type") // proforma | sales_order | tax_invoice | payment_receipt
  documentNumber    String    @map("document_number")
  pdfFilePath       String?   @map("pdf_file_path")
  generatedAt       DateTime  @default(now()) @map("generated_at")
  generatedBy       String?   @map("generated_by")
  isCancelled       Boolean   @default(false) @map("is_cancelled")
  cancelledReason   String?   @map("cancelled_reason") @db.Text

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([documentType, documentNumber])
  @@index([orderId])
  @@index([documentType])
  @@map("order_documents")
  @@schema("sales")
}

model OrderStatusHistory {
  id                          String    @id @default(uuid())
  orderId                     String    @map("order_id")
  fromStatus                  String?   @map("from_status")
  toStatus                    String    @map("to_status")
  changedBy                   String?   @map("changed_by")
  changedAt                   DateTime  @default(now()) @map("changed_at")
  timeInPreviousStatusHours   Decimal?  @map("time_in_previous_status_hours") @db.Decimal(10, 2)
  notes                       String?   @db.Text

  order                       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([toStatus])
  @@map("order_status_history")
  @@schema("sales")
}

model OrderCharge {
  id              String    @id @default(uuid())
  orderId         String    @map("order_id")
  chargeType      String    @map("charge_type") // transport | installation | packaging | other
  description     String?   @db.Text
  amount          Decimal   @db.Decimal(14, 2)
  isTaxable       Boolean   @default(true) @map("is_taxable")
  hsnCode         String?   @map("hsn_code")
  taxRatePercent  Decimal?  @map("tax_rate_percent") @db.Decimal(5, 2)

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_charges")
  @@schema("sales")
}

model OrderTaxBreakup {
  id              String    @id @default(uuid())
  orderId         String    @map("order_id")
  hsnCode         String    @map("hsn_code")
  taxableValue    Decimal   @map("taxable_value") @db.Decimal(14, 2)
  cgstRate        Decimal   @default(0) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount      Decimal   @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstRate        Decimal   @default(0) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount      Decimal   @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstRate        Decimal   @default(0) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount      Decimal   @default(0) @map("igst_amount") @db.Decimal(14, 2)
  totalTax        Decimal   @default(0) @map("total_tax") @db.Decimal(14, 2)

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([hsnCode])
  @@map("order_tax_breakup")
  @@schema("sales")
}

// -- Supporting (3 tables) ----------------------------------------------------

model OrderImportBatch {
  id              String    @id @default(uuid())
  batchCode       String    @unique @map("batch_code")
  fileName        String    @map("file_name")
  totalRows       Int       @default(0) @map("total_rows")
  successCount    Int       @default(0) @map("success_count")
  errorCount      Int       @default(0) @map("error_count")
  status          String    @default("processing") // processing | completed | failed
  importedBy      String?   @map("imported_by")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  errors          OrderImportError[]

  @@index([status])
  @@map("order_import_batches")
  @@schema("sales")
}

model OrderImportError {
  id              String    @id @default(uuid())
  batchId         String    @map("batch_id")
  rowNumber       Int       @map("row_number")
  field           String?
  message         String
  rowData         Json?     @map("row_data")

  createdAt       DateTime  @default(now()) @map("created_at")

  batch           OrderImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("order_import_errors")
  @@schema("sales")
}

model DocumentSequence {
  id                  String    @id @default(uuid())
  documentType        String    @unique @map("document_type") // proforma | sales_order | tax_invoice | payment_receipt
  seriesCode          String    @map("series_code") // FK-like link to core.numbering_series.series_code
  prefix              String
  currentNumber       Int       @default(0) @map("current_number")
  paddingLength       Int       @default(5) @map("padding_length")
  resetYearly         Boolean   @default(true) @map("reset_yearly")
  lastResetAt         DateTime? @map("last_reset_at")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("document_sequences")
  @@schema("sales")
}

// =============================================================================
// SECTION — MATERIAL SCHEMA (Phase 2 — 17 Tables)
// Per MATERIAL_MASTER_DESIGN_LOCK.md Part 3
// =============================================================================

// -- Group A: Classification (3 tables) ----------------------------------------

model MaterialCategory {
  id            String    @id @default(uuid())
  categoryCode  String    @unique @map("category_code")
  name          String
  description   String?   @db.Text
  displayOrder  Int       @default(0) @map("display_order")
  icon          String?
  isActive      Boolean   @default(true) @map("is_active")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdById   String?   @map("created_by_id")
  updatedById   String?   @map("updated_by_id")

  profiles      MaterialCategoryTypeProfile[]
  materials     Material[]
  imageRule     MaterialCategoryImageRule?
  bomMaterialLines BomMaterialLine[]

  @@index([isActive])
  @@map("categories")
  @@schema("material")
}

model MaterialType {
  id                String    @id @default(uuid())
  typeCode          String    @unique @map("type_code")
  name              String
  description       String?   @db.Text
  inventoryBehavior Json?     @map("inventory_behavior")
  displayOrder      Int       @default(0) @map("display_order")
  isActive          Boolean   @default(true) @map("is_active")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  profiles          MaterialCategoryTypeProfile[]
  materials         Material[]
  bomMaterialLines  BomMaterialLine[]

  @@index([isActive])
  @@map("material_types")
  @@schema("material")
}

model MaterialCategoryTypeProfile {
  id              String    @id @default(uuid())
  categoryId      String    @map("category_id")
  materialTypeId  String    @map("material_type_id")
  profileName     String    @map("profile_name")
  isActive        Boolean   @default(true) @map("is_active")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category        MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  materialType    MaterialType     @relation(fields: [materialTypeId], references: [id], onDelete: Restrict)
  attributes      MaterialAttribute[]
  namingFormats   MaterialNamingFormat[]
  materials       Material[]

  @@unique([categoryId, materialTypeId])
  @@index([categoryId])
  @@index([materialTypeId])
  @@index([isActive])
  @@map("category_type_profiles")
  @@schema("material")
}

// -- Group B: Attributes (4 tables) -------------------------------------------

model MaterialAttribute {
  id                      String    @id @default(uuid())
  categoryTypeProfileId   String    @map("category_type_profile_id")
  attributeCode           String    @map("attribute_code")
  label                   String
  fieldType               String    @map("field_type")
  displayOrder            Int       @default(0) @map("display_order")
  displayGroup            String?   @map("display_group")
  isRequired              Boolean   @default(false) @map("is_required")
  isIdentity              Boolean   @default(false) @map("is_identity")
  feedsName               Boolean   @default(false) @map("feeds_name")
  feedsSku                Boolean   @default(false) @map("feeds_sku")
  namePosition            Int?      @map("name_position")
  skuPosition             Int?      @map("sku_position")
  isManufacturerScoped    Boolean   @default(false) @map("is_manufacturer_scoped")
  defaultValue            String?   @map("default_value")
  placeholder             String?
  helpText                String?   @map("help_text") @db.Text
  isActive                Boolean   @default(true) @map("is_active")

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  createdById             String?   @map("created_by_id")
  updatedById             String?   @map("updated_by_id")

  profile                 MaterialCategoryTypeProfile @relation(fields: [categoryTypeProfileId], references: [id], onDelete: Cascade)
  values                  MaterialAttributeValue[]
  visibilityRulesAsTarget MaterialAttributeVisibilityRule[] @relation("VisibilityTarget")
  visibilityRulesAsSource MaterialAttributeVisibilityRule[] @relation("VisibilitySource")
  valueDepsAsTarget       MaterialAttributeValueDependency[] @relation("ValueDepTarget")
  valueDepsAsSource       MaterialAttributeValueDependency[] @relation("ValueDepSource")
  materialValues          MaterialMaterialAttributeValue[]

  @@unique([categoryTypeProfileId, attributeCode])
  @@index([categoryTypeProfileId])
  @@index([isActive])
  @@index([isIdentity])
  @@map("attributes")
  @@schema("material")
}

model MaterialAttributeValue {
  id              String    @id @default(uuid())
  attributeId     String    @map("attribute_id")
  valueLabel      String    @map("value_label")
  valueShortCode  String    @map("value_short_code")
  displayOrder    Int       @default(0) @map("display_order")
  manufacturerId  String?   @map("manufacturer_id")
  swatchImagePath String?   @map("swatch_image_path")
  hexColor        String?   @map("hex_color")
  isActive        Boolean   @default(true) @map("is_active")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdById     String?   @map("created_by_id")
  updatedById     String?   @map("updated_by_id")

  attribute       MaterialAttribute    @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  manufacturer    MaterialManufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  materialValues  MaterialMaterialAttributeValue[]

  @@index([attributeId])
  @@index([manufacturerId])
  @@index([isActive])
  @@map("attribute_values")
  @@schema("material")
}

model MaterialAttributeVisibilityRule {
  id                    String    @id @default(uuid())
  attributeId           String    @map("attribute_id")
  dependsOnAttributeId  String    @map("depends_on_attribute_id")
  conditionOperator     String    @map("condition_operator")
  conditionValues       Json      @map("condition_values")
  action                String

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  attribute             MaterialAttribute @relation("VisibilityTarget", fields: [attributeId], references: [id], onDelete: Cascade)
  dependsOnAttribute    MaterialAttribute @relation("VisibilitySource", fields: [dependsOnAttributeId], references: [id], onDelete: Cascade)

  @@index([attributeId])
  @@index([dependsOnAttributeId])
  @@map("attribute_visibility_rules")
  @@schema("material")
}

model MaterialAttributeValueDependency {
  id                    String    @id @default(uuid())
  attributeId           String    @map("attribute_id")
  dependsOnAttributeId  String    @map("depends_on_attribute_id")
  filterMap             Json      @map("filter_map")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  attribute             MaterialAttribute @relation("ValueDepTarget", fields: [attributeId], references: [id], onDelete: Cascade)
  dependsOnAttribute    MaterialAttribute @relation("ValueDepSource", fields: [dependsOnAttributeId], references: [id], onDelete: Cascade)

  @@index([attributeId])
  @@index([dependsOnAttributeId])
  @@map("attribute_value_dependencies")
  @@schema("material")
}

// -- Group C: Manufacturers & Catalog (3 tables) ------------------------------

model MaterialManufacturer {
  id                String    @id @default(uuid())
  manufacturerCode  String    @unique @map("manufacturer_code")
  name              String
  description       String?   @db.Text
  website           String?
  isActive          Boolean   @default(true) @map("is_active")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdById       String?   @map("created_by_id")
  updatedById       String?   @map("updated_by_id")
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at")
  deletedById       String?   @map("deleted_by_id")

  catalogs          MaterialManufacturerCatalog[]
  attributeValues   MaterialAttributeValue[]
  materials         Material[]
  rateContracts     RateContract[]

  @@index([isActive])
  @@index([isDeleted])
  @@map("manufacturers")
  @@schema("material")
}

model MaterialManufacturerCatalog {
  id                    String    @id @default(uuid())
  manufacturerId        String    @map("manufacturer_id")
  catalogType           String    @map("catalog_type")
  code                  String
  name                  String
  additionalAttributes  Json?     @map("additional_attributes")
  referenceImagePath    String?   @map("reference_image_path")
  isActive              Boolean   @default(true) @map("is_active")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  createdById           String?   @map("created_by_id")
  updatedById           String?   @map("updated_by_id")

  manufacturer          MaterialManufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)

  @@unique([manufacturerId, catalogType, code])
  @@index([manufacturerId])
  @@index([catalogType])
  @@index([isActive])
  @@map("manufacturer_catalogs")
  @@schema("material")
}

model MaterialCatalogImportBatch {
  id              String    @id @default(uuid())
  manufacturerId  String    @map("manufacturer_id")
  catalogType     String    @map("catalog_type")
  sourceFilename  String    @map("source_filename")
  totalRows       Int       @default(0) @map("total_rows")
  successRows     Int       @default(0) @map("success_rows")
  failedRows      Int       @default(0) @map("failed_rows")
  status          String    @default("processing")
  uploadedBy      String?   @map("uploaded_by")
  uploadedAt      DateTime  @default(now()) @map("uploaded_at")
  errorLogPath    String?   @map("error_log_path")

  @@index([manufacturerId])
  @@index([status])
  @@map("catalog_import_batches")
  @@schema("material")
}

// -- Group D: Format Configuration (1 table) ----------------------------------

model MaterialNamingFormat {
  id                      String    @id @default(uuid())
  categoryTypeProfileId   String    @map("category_type_profile_id")
  formatType              String    @map("format_type")
  formatTemplate          Json      @map("format_template")
  separator               String    @default("-")
  previewExample          String?   @map("preview_example")
  isActive                Boolean   @default(true) @map("is_active")

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  createdById             String?   @map("created_by_id")
  updatedById             String?   @map("updated_by_id")

  profile                 MaterialCategoryTypeProfile @relation(fields: [categoryTypeProfileId], references: [id], onDelete: Cascade)

  @@unique([categoryTypeProfileId, formatType])
  @@index([categoryTypeProfileId])
  @@map("naming_formats")
  @@schema("material")
}

// -- Group E: Materials (4 tables) --------------------------------------------

model Material {
  id                      String    @id @default(uuid())
  materialCode            String    @unique @map("material_code")
  materialName            String    @map("material_name")
  categoryId              String    @map("category_id")
  materialTypeId          String    @map("material_type_id")
  categoryTypeProfileId   String    @map("category_type_profile_id")
  manufacturerId          String    @map("manufacturer_id")
  attributeHash           String    @unique @map("attribute_hash")
  purchaseUom             String    @map("purchase_uom")
  consumptionUom          String    @map("consumption_uom")
  uomConversionFactor     Decimal   @default(1) @map("uom_conversion_factor") @db.Decimal(12, 4)
  minStockLevel           Decimal?  @map("min_stock_level") @db.Decimal(14, 3)
  reorderLevel            Decimal?  @map("reorder_level") @db.Decimal(14, 3)
  maxStockLevel           Decimal?  @map("max_stock_level") @db.Decimal(14, 3)
  primaryImagePath        String?   @map("primary_image_path")
  hasPendingImage         Boolean   @default(false) @map("has_pending_image")
  isActive                Boolean   @default(true) @map("is_active")
  notes                   String?   @db.Text

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  createdById             String?   @map("created_by_id")
  updatedById             String?   @map("updated_by_id")
  isDeleted               Boolean   @default(false) @map("is_deleted")
  deletedAt               DateTime? @map("deleted_at")
  deletedById             String?   @map("deleted_by_id")

  category                MaterialCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  materialType            MaterialType                @relation(fields: [materialTypeId], references: [id], onDelete: Restrict)
  profile                 MaterialCategoryTypeProfile @relation(fields: [categoryTypeProfileId], references: [id], onDelete: Restrict)
  manufacturer            MaterialManufacturer        @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  attributeValues         MaterialMaterialAttributeValue[]
  images                  MaterialImage[]
  bomMaterialLines        BomMaterialLine[]
  selectionListItems      SelectionListItem[]
  resolvedBomMaterialLines ResolvedBomMaterialLine[]
  rateContracts           RateContract[]
  stock                   Stock[]
  stockMovements          StockMovement[]
  reservations            Reservation[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines      PurchaseOrderLine[]
  goodsReceiptLines       GoodsReceiptLine[]
  qualityInspections      QualityInspection[]
  importLandedCosts       ImportLandedCostAllocation[]
  materialRequisitionLines MaterialRequisitionLine[]
  materialIssueNoteLines  MaterialIssueNoteLine[]
  materialReturnNoteLines MaterialReturnNoteLine[]
  stockCountLines         StockCountLine[]
  stockAdjustmentLines    StockAdjustmentLine[]
  reorderAlerts           ReorderAlert[]

  @@index([categoryId])
  @@index([materialTypeId])
  @@index([categoryTypeProfileId])
  @@index([manufacturerId])
  @@index([isActive])
  @@index([isDeleted])
  @@index([hasPendingImage])
  @@map("materials")
  @@schema("material")
}

model MaterialMaterialAttributeValue {
  id                String    @id @default(uuid())
  materialId        String    @map("material_id")
  attributeId       String    @map("attribute_id")
  attributeValueId  String?   @map("attribute_value_id")
  rawValue          String?   @map("raw_value")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  material          Material               @relation(fields: [materialId], references: [id], onDelete: Cascade)
  attribute         MaterialAttribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  attributeValue    MaterialAttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)

  @@unique([materialId, attributeId])
  @@index([materialId])
  @@index([attributeId])
  @@index([attributeValueId])
  @@map("material_attribute_values")
  @@schema("material")
}

model MaterialImage {
  id            String    @id @default(uuid())
  materialId    String    @map("material_id")
  imagePath     String    @map("image_path")
  imageType     String    @map("image_type")
  isPrimary     Boolean   @default(false) @map("is_primary")
  displayOrder  Int       @default(0) @map("display_order")
  uploadedBy    String?   @map("uploaded_by")
  uploadedAt    DateTime  @default(now()) @map("uploaded_at")

  material      Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([imageType])
  @@map("material_images")
  @@schema("material")
}

model MaterialCategoryImageRule {
  id                String    @id @default(uuid())
  categoryId        String    @unique @map("category_id")
  imageRequirement  String    @map("image_requirement")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  category          MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_image_rules")
  @@schema("material")
}

// -- Group F: Import (2 tables) -----------------------------------------------

model MaterialImportBatch {
  id              String    @id @default(uuid())
  categoryId      String?   @map("category_id")
  materialTypeId  String?   @map("material_type_id")
  sourceFilename  String    @map("source_filename")
  totalRows       Int       @default(0) @map("total_rows")
  successRows     Int       @default(0) @map("success_rows")
  failedRows      Int       @default(0) @map("failed_rows")
  status          String    @default("processing")
  onDuplicate     String    @default("skip") @map("on_duplicate")
  importedBy      String?   @map("imported_by")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  errors          MaterialImportError[]

  @@index([status])
  @@map("material_import_batches")
  @@schema("material")
}

model MaterialImportError {
  id          String    @id @default(uuid())
  batchId     String    @map("batch_id")
  rowNumber   Int       @map("row_number")
  field       String?
  message     String
  rowData     Json?     @map("row_data")
  correctedData Json?   @map("corrected_data")
  isResolved  Boolean   @default(false) @map("is_resolved")

  createdAt   DateTime  @default(now()) @map("created_at")

  batch       MaterialImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([isResolved])
  @@map("material_import_errors")
  @@schema("material")
}

// =============================================================================
// PRODUCT ENGINEERING SCHEMA — Processes, BOM, Selection Lists, Costing
// =============================================================================

model Process {
  id                          String    @id @default(uuid())
  processCode                 String    @unique @map("process_code")
  processName                 String    @map("process_name")
  processCategory             String    @map("process_category") // cutting | edge_banding | drilling | lamination | sanding | assembly | finishing | outsource
  standardTimeMinutes         Decimal?  @map("standard_time_minutes") @db.Decimal(10, 2)
  timeUnit                    String    @default("per_panel") @map("time_unit") // per_panel | per_sheet | per_job
  laborCostPerHour            Decimal?  @map("labor_cost_per_hour") @db.Decimal(10, 2)
  machineCostPerHour          Decimal?  @map("machine_cost_per_hour") @db.Decimal(10, 2)
  isOutsourced                Boolean   @default(false) @map("is_outsourced")
  defaultOutsourceVendorNotes String?   @map("default_outsource_vendor_notes") @db.Text
  stationId                   String?   @map("station_id") // Phase 4 FK placeholder
  isActive                    Boolean   @default(true) @map("is_active")

  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  createdById                 String?   @map("created_by_id")
  updatedById                 String?   @map("updated_by_id")

  capabilities                ProcessCapability[]
  bomProcessLines             BomProcessLine[]
  resolvedBomProcessLines     ResolvedBomProcessLine[]

  @@index([processCategory])
  @@index([isActive])
  @@map("processes")
  @@schema("product_engineering")
}

model ProcessCapability {
  id               String    @id @default(uuid())
  processId        String    @map("process_id")
  capabilityKey    String    @map("capability_key")
  capabilityValue  String    @map("capability_value")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  process          Process   @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("process_capabilities")
  @@schema("product_engineering")
}

model Bom {
  id                      String    @id @default(uuid())
  bomCode                 String    @unique @map("bom_code")
  productId               String    @map("product_id")
  productSizeVariantId    String?   @map("product_size_variant_id")
  bomName                 String    @map("bom_name")
  description             String?   @db.Text
  bomPurpose              String    @default("estimation_and_po") @map("bom_purpose") // estimation_and_po | informational
  status                  String    @default("draft") // draft | active | superseded | archived
  currentVersion          Int       @default(0) @map("current_version")
  isLockedForOrders       Boolean   @default(false) @map("is_locked_for_orders")
  createdBy               String?   @map("created_by")
  approvedBy              String?   @map("approved_by")
  approvedAt              DateTime? @map("approved_at")

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  createdById             String?   @map("created_by_id")
  updatedById             String?   @map("updated_by_id")
  isDeleted               Boolean   @default(false) @map("is_deleted")
  deletedAt               DateTime? @map("deleted_at")
  deletedById             String?   @map("deleted_by_id")

  product                 Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  sizeVariant             ProductSizeVariant? @relation(fields: [productSizeVariantId], references: [id], onDelete: SetNull)
  versions                BomVersion[]
  changeLogs              BomChangeLog[]
  childOf                 BomSubassembly[]   @relation("ChildBom")

  @@index([productId])
  @@index([productSizeVariantId])
  @@index([status])
  @@index([isDeleted])
  @@map("boms")
  @@schema("product_engineering")
}

model BomVersion {
  id                       String    @id @default(uuid())
  bomId                    String    @map("bom_id")
  versionNumber            Int       @map("version_number")
  versionStatus            String    @default("draft") @map("version_status") // draft | approved | superseded
  supersedesVersionId      String?   @map("supersedes_version_id")
  revisionSummary          String?   @map("revision_summary") @db.Text
  approvedBy               String?   @map("approved_by")
  approvedAt               DateTime? @map("approved_at")
  lockedAtProductionStart  DateTime? @map("locked_at_production_start")

  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  createdById              String?   @map("created_by_id")
  updatedById              String?   @map("updated_by_id")
  isDeleted                Boolean   @default(false) @map("is_deleted")
  deletedAt                DateTime? @map("deleted_at")
  deletedById              String?   @map("deleted_by_id")

  bom                      Bom           @relation(fields: [bomId], references: [id], onDelete: Cascade)
  supersedesVersion        BomVersion?   @relation("VersionSupersession", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededBy             BomVersion[]  @relation("VersionSupersession")
  materialLines            BomMaterialLine[]
  processLines             BomProcessLine[]
  subassemblies            BomSubassembly[]
  changeLogs               BomChangeLog[]
  resolvedBoms             ResolvedBom[]
  costingRuns              CostingRun[]

  @@unique([bomId, versionNumber])
  @@index([bomId])
  @@index([versionStatus])
  @@index([isDeleted])
  @@map("bom_versions")
  @@schema("product_engineering")
}

model BomMaterialLine {
  id                    String    @id @default(uuid())
  bomVersionId          String    @map("bom_version_id")
  lineSequence          Int       @map("line_sequence")
  lineType              String    @default("primary") @map("line_type") // primary | alternate
  alternateGroupId      String?   @map("alternate_group_id")
  materialCategoryId    String?   @map("material_category_id")
  materialTypeId        String?   @map("material_type_id")
  specificMaterialId    String?   @map("specific_material_id")
  isFinishDependent     Boolean   @default(false) @map("is_finish_dependent")
  quantityPerUnit       Decimal   @map("quantity_per_unit") @db.Decimal(14, 4)
  uom                   String    @default("PCS")
  wastagePercent        Decimal   @default(0) @map("wastage_percent") @db.Decimal(5, 2)
  notes                 String?   @db.Text

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  bomVersion            BomVersion        @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  materialCategory      MaterialCategory? @relation(fields: [materialCategoryId], references: [id], onDelete: SetNull)
  materialType          MaterialType?     @relation(fields: [materialTypeId], references: [id], onDelete: SetNull)
  specificMaterial      Material?         @relation(fields: [specificMaterialId], references: [id], onDelete: SetNull)
  selectionListItems    SelectionListItem[]
  resolvedBomMaterialLines ResolvedBomMaterialLine[]

  @@index([bomVersionId])
  @@index([materialCategoryId])
  @@index([materialTypeId])
  @@index([specificMaterialId])
  @@index([alternateGroupId])
  @@map("bom_material_lines")
  @@schema("product_engineering")
}

model BomProcessLine {
  id                    String    @id @default(uuid())
  bomVersionId          String    @map("bom_version_id")
  lineSequence          Int       @map("line_sequence")
  processId             String    @map("process_id")
  quantity              Decimal   @default(1) @db.Decimal(10, 3)
  timePerUnitMinutes    Decimal?  @map("time_per_unit_minutes") @db.Decimal(10, 2)
  isOutsourced          Boolean   @default(false) @map("is_outsourced")
  outsourceVendorNotes  String?   @map("outsource_vendor_notes") @db.Text
  estimatedCost         Decimal?  @map("estimated_cost") @db.Decimal(14, 2)
  notes                 String?   @db.Text

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  bomVersion            BomVersion @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  process               Process    @relation(fields: [processId], references: [id], onDelete: Restrict)
  resolvedBomProcessLines ResolvedBomProcessLine[]

  @@index([bomVersionId])
  @@index([processId])
  @@map("bom_process_lines")
  @@schema("product_engineering")
}

model BomSubassembly {
  id                    String    @id @default(uuid())
  parentBomVersionId    String    @map("parent_bom_version_id")
  childBomId            String    @map("child_bom_id")
  quantity              Decimal   @default(1) @db.Decimal(10, 3)
  notes                 String?   @db.Text

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  parentBomVersion      BomVersion @relation(fields: [parentBomVersionId], references: [id], onDelete: Cascade)
  childBom              Bom        @relation("ChildBom", fields: [childBomId], references: [id], onDelete: Restrict)

  @@index([parentBomVersionId])
  @@index([childBomId])
  @@map("bom_subassemblies")
  @@schema("product_engineering")
}

model BomChangeLog {
  id              String    @id @default(uuid())
  bomId           String    @map("bom_id")
  versionId       String?   @map("version_id")
  changeType      String    @map("change_type") // line_added | line_removed | line_modified | version_approved | version_superseded
  changedBy       String?   @map("changed_by")
  changedAt       DateTime  @default(now()) @map("changed_at")
  changeDetails   Json?     @map("change_details")

  bom             Bom         @relation(fields: [bomId], references: [id], onDelete: Cascade)
  version         BomVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([bomId])
  @@index([versionId])
  @@index([changeType])
  @@map("bom_change_log")
  @@schema("product_engineering")
}

model SelectionList {
  id                    String    @id @default(uuid())
  selectionListCode     String    @unique @map("selection_list_code")
  orderId               String    @map("order_id")
  status                String    @default("draft") // draft | submitted | approved | applied_to_bom
  submittedByType       String?   @map("submitted_by_type") // customer | sales_team | engineering
  submittedByUserId     String?   @map("submitted_by_user_id")
  submittedAt           DateTime? @map("submitted_at")
  approvedBy            String?   @map("approved_by")
  approvedAt            DateTime? @map("approved_at")
  finishGroupName       String?   @map("finish_group_name")
  notes                 String?   @db.Text

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  createdById           String?   @map("created_by_id")
  updatedById           String?   @map("updated_by_id")
  isDeleted             Boolean   @default(false) @map("is_deleted")
  deletedAt             DateTime? @map("deleted_at")
  deletedById           String?   @map("deleted_by_id")

  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items                 SelectionListItem[]
  resolvedBoms          ResolvedBom[]

  @@index([orderId])
  @@index([status])
  @@index([isDeleted])
  @@map("selection_lists")
  @@schema("product_engineering")
}

model SelectionListItem {
  id                    String    @id @default(uuid())
  selectionListId       String    @map("selection_list_id")
  orderLineId           String?   @map("order_line_id")
  bomMaterialLineId     String    @map("bom_material_line_id")
  selectedMaterialId    String    @map("selected_material_id")
  alternateChosen       Boolean   @default(false) @map("alternate_chosen")
  quantityOverride      Decimal?  @map("quantity_override") @db.Decimal(14, 4)
  notes                 String?   @db.Text

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  selectionList         SelectionList   @relation(fields: [selectionListId], references: [id], onDelete: Cascade)
  orderLine             OrderLine?      @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  bomMaterialLine       BomMaterialLine @relation(fields: [bomMaterialLineId], references: [id], onDelete: Restrict)
  selectedMaterial      Material        @relation(fields: [selectedMaterialId], references: [id], onDelete: Restrict)

  @@index([selectionListId])
  @@index([orderLineId])
  @@index([bomMaterialLineId])
  @@index([selectedMaterialId])
  @@map("selection_list_items")
  @@schema("product_engineering")
}

model ResolvedBom {
  id                           String    @id @default(uuid())
  orderId                      String    @map("order_id")
  orderLineId                  String    @map("order_line_id")
  bomVersionId                 String    @map("bom_version_id")
  selectionListId              String?   @map("selection_list_id")
  resolvedAt                   DateTime? @map("resolved_at")
  resolvedBy                   String?   @map("resolved_by")
  totalTheoreticalMaterialCost Decimal?  @map("total_theoretical_material_cost") @db.Decimal(14, 2)
  status                       String    @default("draft") // draft | approved | locked_for_production

  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")
  createdById                  String?   @map("created_by_id")
  updatedById                  String?   @map("updated_by_id")
  isDeleted                    Boolean   @default(false) @map("is_deleted")
  deletedAt                    DateTime? @map("deleted_at")
  deletedById                  String?   @map("deleted_by_id")

  order                        Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLine                    OrderLine      @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  bomVersion                   BomVersion     @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)
  selectionList                SelectionList? @relation(fields: [selectionListId], references: [id], onDelete: SetNull)
  materialLines                ResolvedBomMaterialLine[]
  processLines                 ResolvedBomProcessLine[]

  @@unique([orderId, orderLineId, bomVersionId])
  @@index([orderId])
  @@index([orderLineId])
  @@index([bomVersionId])
  @@index([selectionListId])
  @@index([status])
  @@index([isDeleted])
  @@map("resolved_boms")
  @@schema("product_engineering")
}

model ResolvedBomMaterialLine {
  id                              String    @id @default(uuid())
  resolvedBomId                   String    @map("resolved_bom_id")
  bomMaterialLineId               String    @map("bom_material_line_id")
  materialId                      String    @map("material_id")
  quantityRequired                Decimal   @map("quantity_required") @db.Decimal(14, 4)
  uom                             String    @default("PCS")
  wastagePercentApplied           Decimal   @default(0) @map("wastage_percent_applied") @db.Decimal(5, 2)
  theoreticalQuantityWithWastage  Decimal?  @map("theoretical_quantity_with_wastage") @db.Decimal(14, 4)
  unitCostAtResolution            Decimal?  @map("unit_cost_at_resolution") @db.Decimal(14, 2)
  lineCost                        Decimal?  @map("line_cost") @db.Decimal(14, 2)

  createdAt                       DateTime  @default(now()) @map("created_at")
  updatedAt                       DateTime  @updatedAt @map("updated_at")

  resolvedBom                     ResolvedBom     @relation(fields: [resolvedBomId], references: [id], onDelete: Cascade)
  bomMaterialLine                 BomMaterialLine @relation(fields: [bomMaterialLineId], references: [id], onDelete: Restrict)
  material                        Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([resolvedBomId])
  @@index([bomMaterialLineId])
  @@index([materialId])
  @@map("resolved_bom_material_lines")
  @@schema("product_engineering")
}

model ResolvedBomProcessLine {
  id                       String    @id @default(uuid())
  resolvedBomId            String    @map("resolved_bom_id")
  bomProcessLineId         String    @map("bom_process_line_id")
  processId                String    @map("process_id")
  quantity                 Decimal   @default(1) @db.Decimal(10, 3)
  timePerUnitMinutes       Decimal?  @map("time_per_unit_minutes") @db.Decimal(10, 2)
  costPerUnitAtResolution  Decimal?  @map("cost_per_unit_at_resolution") @db.Decimal(14, 2)
  lineCost                 Decimal?  @map("line_cost") @db.Decimal(14, 2)
  isOutsourced             Boolean   @default(false) @map("is_outsourced")
  vendorNotes              String?   @map("vendor_notes") @db.Text

  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  resolvedBom              ResolvedBom    @relation(fields: [resolvedBomId], references: [id], onDelete: Cascade)
  bomProcessLine           BomProcessLine @relation(fields: [bomProcessLineId], references: [id], onDelete: Restrict)
  process                  Process        @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@index([resolvedBomId])
  @@index([bomProcessLineId])
  @@index([processId])
  @@map("resolved_bom_process_lines")
  @@schema("product_engineering")
}

model CostingRun {
  id                      String    @id @default(uuid())
  bomVersionId            String    @map("bom_version_id")
  costingRunNumber        String    @unique @map("costing_run_number")
  runType                 String    @default("initial") @map("run_type") // initial | re_cost | what_if
  materialCostTotal       Decimal   @default(0) @map("material_cost_total") @db.Decimal(14, 2)
  laborCostTotal          Decimal   @default(0) @map("labor_cost_total") @db.Decimal(14, 2)
  overheadCostTotal       Decimal   @default(0) @map("overhead_cost_total") @db.Decimal(14, 2)
  outsourcingCostTotal    Decimal   @default(0) @map("outsourcing_cost_total") @db.Decimal(14, 2)
  manufacturingCost       Decimal   @default(0) @map("manufacturing_cost") @db.Decimal(14, 2)
  overheadPercentApplied  Decimal?  @map("overhead_percent_applied") @db.Decimal(5, 2)
  marginPercentApplied    Decimal?  @map("margin_percent_applied") @db.Decimal(5, 2)
  landingCost             Decimal?  @map("landing_cost") @db.Decimal(14, 2)
  sellingPriceExclTax     Decimal?  @map("selling_price_excl_tax") @db.Decimal(14, 2)
  taxRate                 Decimal?  @map("tax_rate") @db.Decimal(5, 2)
  mrpInclTax              Decimal?  @map("mrp_incl_tax") @db.Decimal(14, 2)
  runBy                   String?   @map("run_by")
  runAt                   DateTime  @default(now()) @map("run_at")
  notes                   String?   @db.Text

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  bomVersion              BomVersion @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)

  @@index([bomVersionId])
  @@index([runType])
  @@map("costing_runs")
  @@schema("product_engineering")
}

model CostingAssumption {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  validFrom   DateTime  @default(now()) @map("valid_from")
  validUntil  DateTime? @map("valid_until")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  @@map("costing_assumptions")
  @@schema("product_engineering")
}

// ═══════════════════════════════════════════════════════════════════════════════
// VENDOR SCHEMA
// ═══════════════════════════════════════════════════════════════════════════════

model Vendor {
  id                      String    @id @default(uuid())
  vendorCode              String    @unique @map("vendor_code")
  vendorName              String    @map("vendor_name")
  legalName               String?   @map("legal_name")
  vendorType              String    @default("domestic") @map("vendor_type") // domestic | import
  isBlacklisted           Boolean   @default(false) @map("is_blacklisted")
  blacklistReason         String?   @map("blacklist_reason") @db.Text
  gstin                   String?
  pan                     String?
  msmeRegistered          Boolean   @default(false) @map("msme_registered")
  msmeNumber              String?   @map("msme_number")
  primaryEmail            String?   @map("primary_email")
  primaryPhone            String?   @map("primary_phone")
  website                 String?
  currencyCode            String    @default("INR") @map("currency_code")
  paymentTermsTemplateId  String?   @map("payment_terms_template_id")
  creditLimit             Decimal?  @map("credit_limit") @db.Decimal(14, 2)
  creditDays              Int?      @map("credit_days")
  bankName                String?   @map("bank_name")
  bankAccountNumber       String?   @map("bank_account_number")
  bankIfsc                String?   @map("bank_ifsc")
  bankSwiftCode           String?   @map("bank_swift_code")
  rating                  Int?      @db.SmallInt // 1-5
  isActive                Boolean   @default(true) @map("is_active")
  iecCode                 String?   @map("iec_code")
  defaultIncoterms        String?   @map("default_incoterms")

  isDeleted               Boolean   @default(false) @map("is_deleted")
  deletedAt               DateTime? @map("deleted_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  createdById             String?   @map("created_by_id")
  updatedById             String?   @map("updated_by_id")

  paymentTermsTemplate    PaymentTermsTemplate? @relation(fields: [paymentTermsTemplateId], references: [id])
  contacts                VendorContact[]
  addresses               VendorAddress[]
  documents               VendorDocument[]
  rateContracts           RateContract[]
  purchaseOrders          PurchaseOrder[]
  goodsReceiptNotes       GoodsReceiptNote[]

  @@index([vendorType])
  @@index([isActive])
  @@index([isBlacklisted])
  @@map("vendors")
  @@schema("vendor")
}

model VendorContact {
  id           String    @id @default(uuid())
  vendorId     String    @map("vendor_id")
  contactName  String    @map("contact_name")
  designation  String?
  phone        String?
  email        String?
  role         String    @default("sales") // sales | accounts | dispatch | owner
  isPrimary    Boolean   @default(false) @map("is_primary")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  vendor       Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_contacts")
  @@schema("vendor")
}

model VendorAddress {
  id              String    @id @default(uuid())
  vendorId        String    @map("vendor_id")
  addressType     String    @map("address_type") // registered | factory | warehouse | billing
  addressLine1    String    @map("address_line_1")
  addressLine2    String?   @map("address_line_2")
  city            String
  state           String?
  stateCode       String?   @map("state_code")
  country         String    @default("India")
  pincode         String?
  portOfLoading   String?   @map("port_of_loading")
  notes           String?   @db.Text

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_addresses")
  @@schema("vendor")
}

model VendorDocument {
  id             String    @id @default(uuid())
  vendorId       String    @map("vendor_id")
  documentType   String    @map("document_type") // gst_cert | pan | iec | agreement | quality_cert | insurance
  documentPath   String    @map("document_path")
  validFrom      DateTime? @map("valid_from")
  validUntil     DateTime? @map("valid_until")
  notes          String?   @db.Text

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  uploadedBy     String?   @map("uploaded_by")

  vendor         Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([validUntil])
  @@map("vendor_documents")
  @@schema("vendor")
}

model RateContract {
  id                  String    @id @default(uuid())
  vendorId            String    @map("vendor_id")
  materialId          String    @map("material_id")
  manufacturerId      String?   @map("manufacturer_id")
  isAuthorizedDealer  Boolean   @default(false) @map("is_authorized_dealer")
  unitPrice           Decimal   @map("unit_price") @db.Decimal(14, 4)
  currencyCode        String    @default("INR") @map("currency_code")
  uom                 String    @default("PCS")
  minOrderQuantity    Decimal?  @map("min_order_quantity") @db.Decimal(10, 3)
  leadTimeDays        Int?      @map("lead_time_days")
  validityFrom        DateTime  @map("validity_from")
  validityUntil       DateTime? @map("validity_until")
  isPreferred         Boolean   @default(false) @map("is_preferred")
  notes               String?   @db.Text

  isDeleted           Boolean   @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdById         String?   @map("created_by_id")
  updatedById         String?   @map("updated_by_id")

  vendor              Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  material            Material              @relation(fields: [materialId], references: [id], onDelete: Restrict)
  manufacturer        MaterialManufacturer? @relation(fields: [manufacturerId], references: [id])
  history             RateContractHistory[]

  @@unique([vendorId, materialId, validityFrom])
  @@index([vendorId])
  @@index([materialId])
  @@index([manufacturerId])
  @@index([validityUntil])
  @@map("rate_contracts")
  @@schema("vendor")
}

model RateContractHistory {
  id              String    @id @default(uuid())
  rateContractId  String    @map("rate_contract_id")
  oldPrice        Decimal   @map("old_price") @db.Decimal(14, 4)
  newPrice        Decimal   @map("new_price") @db.Decimal(14, 4)
  changeReason    String?   @map("change_reason") @db.Text
  changedAt       DateTime  @default(now()) @map("changed_at")
  changedBy       String?   @map("changed_by")

  rateContract    RateContract @relation(fields: [rateContractId], references: [id], onDelete: Cascade)

  @@index([rateContractId])
  @@map("rate_contract_history")
  @@schema("vendor")
}

// ═══════════════════════════════════════════════════════════════════════════════
// INVENTORY SCHEMA
// ═══════════════════════════════════════════════════════════════════════════════

model StorageLocation {
  id               String    @id @default(uuid())
  locationCode     String    @unique @map("location_code")
  locationName     String    @map("location_name")
  locationType     String    @map("location_type") // factory_store | warehouse | shop_floor | qc_hold | quarantine | returns_hold
  branchId         String?   @map("branch_id")
  parentLocationId String?   @map("parent_location_id")
  description      String?   @db.Text
  isActive         Boolean   @default(true) @map("is_active")
  isFrozen         Boolean   @default(false) @map("is_frozen")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  branch           Branch?          @relation(fields: [branchId], references: [id])
  parentLocation   StorageLocation? @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations   StorageLocation[] @relation("LocationHierarchy")
  racks            StorageRack[]
  generalAreas     StorageGeneralArea[]
  stock            Stock[]
  stockMovementsFrom StockMovement[] @relation("MovementSource")
  stockMovementsTo   StockMovement[] @relation("MovementDest")
  goodsReceiptNotes  GoodsReceiptNote[]
  materialIssueNotes MaterialIssueNote[]
  materialReturnNotes MaterialReturnNote[] @relation("ReturnReceiveLocation")
  reservations       Reservation[]
  stockCountSessions StockCountSession[]

  @@index([branchId])
  @@index([parentLocationId])
  @@index([locationType])
  @@map("storage_locations")
  @@schema("inventory")
}

model StorageRack {
  id             String    @id @default(uuid())
  locationId     String    @map("location_id")
  rackCode       String    @map("rack_code")
  rackName       String?   @map("rack_name")
  capacityKg     Decimal?  @map("capacity_kg") @db.Decimal(10, 2)
  capacityVolume Decimal?  @map("capacity_volume") @db.Decimal(10, 2)
  notes          String?   @db.Text
  isActive       Boolean   @default(true) @map("is_active")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  location       StorageLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  bins           StorageBin[]

  @@unique([locationId, rackCode])
  @@index([locationId])
  @@map("storage_racks")
  @@schema("inventory")
}

model StorageBin {
  id                          String    @id @default(uuid())
  rackId                      String    @map("rack_id")
  binCode                     String    @map("bin_code")
  binLabel                    String?   @map("bin_label")
  capacity                    Decimal?  @db.Decimal(10, 2)
  materialCategoryRestriction String?   @map("material_category_restriction")
  isActive                    Boolean   @default(true) @map("is_active")

  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  rack                        StorageRack @relation(fields: [rackId], references: [id], onDelete: Cascade)
  stock                       Stock[]
  stockMovementsFrom          StockMovement[] @relation("MovementSourceBin")
  stockMovementsTo            StockMovement[] @relation("MovementDestBin")
  goodsReceiptLines           GoodsReceiptLine[]
  materialIssueNoteLines      MaterialIssueNoteLine[]
  stockCountLines             StockCountLine[]

  @@unique([rackId, binCode])
  @@index([rackId])
  @@map("storage_bins")
  @@schema("inventory")
}

model StorageGeneralArea {
  id                          String    @id @default(uuid())
  locationId                  String    @map("location_id")
  areaCode                    String    @map("area_code")
  areaName                    String    @map("area_name")
  description                 String?   @db.Text
  materialCategoryRestriction String?   @map("material_category_restriction")
  isActive                    Boolean   @default(true) @map("is_active")

  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  location                    StorageLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  stock                       Stock[]
  goodsReceiptLines           GoodsReceiptLine[]
  stockCountLines             StockCountLine[]

  @@unique([locationId, areaCode])
  @@index([locationId])
  @@map("storage_general_areas")
  @@schema("inventory")
}

model Stock {
  id                   String    @id @default(uuid())
  materialId           String    @map("material_id")
  locationId           String    @map("location_id")
  binId                String?   @map("bin_id")
  generalAreaId        String?   @map("general_area_id")
  currentQuantity      Decimal   @default(0) @map("current_quantity") @db.Decimal(14, 4)
  reservedQuantitySoft Decimal   @default(0) @map("reserved_quantity_soft") @db.Decimal(14, 4)
  reservedQuantityHard Decimal   @default(0) @map("reserved_quantity_hard") @db.Decimal(14, 4)
  lastMovementAt       DateTime? @map("last_movement_at")
  lastCountAt          DateTime? @map("last_count_at")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  material             Material         @relation(fields: [materialId], references: [id], onDelete: Restrict)
  location             StorageLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  bin                  StorageBin?      @relation(fields: [binId], references: [id])
  generalArea          StorageGeneralArea? @relation(fields: [generalAreaId], references: [id])
  batches              StockBatch[]

  @@unique([materialId, locationId, binId])
  @@index([materialId])
  @@index([locationId])
  @@index([binId])
  @@index([generalAreaId])
  @@map("stock")
  @@schema("inventory")
}

model StockBatch {
  id               String    @id @default(uuid())
  stockId          String    @map("stock_id")
  batchNumber      String?   @map("batch_number")
  grnId            String?   @map("grn_id")
  receivedAt       DateTime  @default(now()) @map("received_at")
  originalQuantity Decimal   @map("original_quantity") @db.Decimal(14, 4)
  currentQuantity  Decimal   @map("current_quantity") @db.Decimal(14, 4)
  unitCost         Decimal   @map("unit_cost") @db.Decimal(14, 4)
  totalCost        Decimal   @map("total_cost") @db.Decimal(14, 2)
  expiryDate       DateTime? @map("expiry_date")
  lotNumber        String?   @map("lot_number")
  isQuarantined    Boolean   @default(false) @map("is_quarantined")
  quarantineReason String?   @map("quarantine_reason") @db.Text

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  stock            Stock             @relation(fields: [stockId], references: [id], onDelete: Cascade)
  grn              GoodsReceiptNote? @relation(fields: [grnId], references: [id])
  stockMovements   StockMovement[]
  materialIssueNoteLines MaterialIssueNoteLine[]

  @@index([stockId])
  @@index([grnId])
  @@index([receivedAt])
  @@map("stock_batches")
  @@schema("inventory")
}

model StockMovement {
