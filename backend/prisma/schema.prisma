model AuditLog {
  id              String   @id @default(uuid())
  entityType      String   @map("entity_type")
  entityId        String?  @map("entity_id")
  action          String   // create | update | delete | login | logout | permission_change
  actorUserId     String?  @map("actor_user_id")
  actorIp         String?  @map("actor_ip")
  actorUserAgent  String?  @map("actor_user_agent")
  beforeData      Json?    @map("before_data")
  afterData       Json?    @map("after_data")
  changesSummary  String?  @map("changes_summary")
  actionAt        DateTime @default(now()) @map("action_at")
  requestId       String?  @map("request_id")

  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([actorUserId])
  @@index([actionAt])
  @@index([requestId])
  @@map("audit_logs")
  @@schema("core")
}

model DpdpConsent {
  id                String    @id @default(uuid())
  userId            String?   @map("user_id")
  customerUserId    String?   @map("customer_user_id")
  consentType       String    @map("consent_type") // terms | privacy | marketing | cookies
  versionId         String?   @map("version_id")
  consentedAt       DateTime  @default(now()) @map("consented_at")
  consentMethod     String?   @map("consent_method") // signup | banner | api
  ipAddress         String?   @map("ip_address")
  withdrawnAt       DateTime? @map("withdrawn_at")
  withdrawalReason  String?   @map("withdrawal_reason")

  user              User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerUser      CustomerUser? @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerUserId])
  @@index([consentType])
  @@map("dpdp_consents")
  @@schema("core")
}

model DpdpDataRequest {
  id              String    @id @default(uuid())
  requesterType   String    @map("requester_type") // employee | customer
  requesterId     String    @map("requester_id")
  requestType     String    @map("request_type")   // export | erasure
  status          String    @default("submitted")  // submitted | processing | completed | rejected
  submittedAt     DateTime  @default(now()) @map("submitted_at")
  processedAt     DateTime? @map("processed_at")
  processedById   String?   @map("processed_by_id")
  responseDataUrl String?   @map("response_data_url")

  @@index([requesterType, requesterId])
  @@index([status])
  @@map("dpdp_data_requests")
  @@schema("core")
}

model PrivacyPolicyVersion {
  id            String    @id @default(uuid())
  version       String
  content       String    @db.Text
  effectiveFrom DateTime  @map("effective_from")
  isActive      Boolean   @default(false) @map("is_active")

  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([version])
  @@index([isActive])
  @@map("privacy_policy_versions")
  @@schema("core")
}

model TermsOfServiceVersion {
  id            String    @id @default(uuid())
  version       String
  content       String    @db.Text
  effectiveFrom DateTime  @map("effective_from")
  isActive      Boolean   @default(false) @map("is_active")

  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([version])
  @@index([isActive])
  @@map("terms_of_service_versions")
  @@schema("core")
}

// =============================================================================
// SECTION 6 — Communication (6 tables)
// =============================================================================

model EmailProvider {
  id              String   @id @default(uuid())
  providerName    String   @map("provider_name") // smtp | sendgrid | ses | mailgun
  // providerCode is the IMPLEMENTATION TYPE (smtp / sendgrid / ses / mailgun
  // / log), NOT a unique identifier. Multiple rows with the same code are
  // expected (e.g. a primary SMTP + a fallback SMTP from a different host).
  providerCode    String   @map("provider_code")
  configuration   Json     // @encrypted (smtp creds, API keys)
  fromEmail       String   @map("from_email")
  fromName        String?  @map("from_name")
  isPrimary       Boolean  @default(false) @map("is_primary")
  isActive        Boolean  @default(true) @map("is_active")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdById     String?  @map("created_by_id")
  updatedById     String?  @map("updated_by_id")

  notificationLogs NotificationLog[]

  @@index([isActive])
  @@index([isPrimary])
  @@map("email_providers")
  @@schema("core")
}

model SmsProvider {
  id              String   @id @default(uuid())
  providerName    String   @map("provider_name") // msg91 | twilio | ...
  // Implementation type, NOT a unique identifier — multiple rows with the
  // same code allowed (e.g. primary MSG91 + fallback MSG91 with different
  // sender IDs). Mirrors the email-provider fix from P0-15.
  providerCode    String   @map("provider_code")
  configuration   Json     // @encrypted
  senderId        String?  @map("sender_id")     // DLT-registered for India
  isPrimary       Boolean  @default(false) @map("is_primary")
  isActive        Boolean  @default(true) @map("is_active")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdById     String?  @map("created_by_id")
  updatedById     String?  @map("updated_by_id")

  @@index([isActive])
  @@index([isPrimary])
  @@map("sms_providers")
  @@schema("core")
}

model WhatsappProvider {
  id              String   @id @default(uuid())
  providerName    String   @map("provider_name")
  providerCode    String   @map("provider_code")
  configuration   Json     // @encrypted
  phoneNumberId   String?  @map("phone_number_id")
  businessAccountId String? @map("business_account_id")
  webhookSecret   String?  @map("webhook_secret")
  isPrimary       Boolean  @default(false) @map("is_primary")
  isActive        Boolean  @default(true) @map("is_active")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdById     String?  @map("created_by_id")
  updatedById     String?  @map("updated_by_id")

  notificationLogs NotificationLog[]

  @@index([isActive])
  @@index([isPrimary])
  @@map("whatsapp_providers")
  @@schema("core")
}

model CommunicationTemplate {
  id                String   @id @default(uuid())
  templateCode      String   @unique @map("template_code")
  name              String
  channel           String   // email | sms | whatsapp
  subjectTemplate   String?  @map("subject_template")
  bodyTemplate      String   @db.Text @map("body_template")
  variablesSchema   Json?    @map("variables_schema")
  // DLT (TRAI / India) compliance for SMS templates. Each registered
  // template gets a Telecom-issued ID; the SMS service refuses sends when
  // DLT enforcement is on and dltTemplateId is missing. Optional for
  // non-SMS templates.
  dltTemplateId     String?  @map("dlt_template_id")
  // WhatsApp-specific: Meta-approved templates have structured
  // header/footer/buttons and a namespace from the BSP.
  waApprovalStatus  String?  @map("wa_approval_status") // draft | submitted | approved | rejected
  waNamespace       String?  @map("wa_namespace")
  headerTemplate    String?  @map("header_template")
  footerTemplate    String?  @map("footer_template")
  buttonsTemplate   Json?    @map("buttons_template")
  isActive          Boolean  @default(true) @map("is_active")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdById       String?  @map("created_by_id")
  updatedById       String?  @map("updated_by_id")

  @@index([channel])
  @@index([isActive])
  @@map("communication_templates")
  @@schema("core")
}

model Notification {
  id                  String    @id @default(uuid())
  // Nullable so system-generated messages without a target user (anonymous
  // forgot-password sends, broadcast SMS, etc.) can still be recorded.
  recipientUserId     String?   @map("recipient_user_id")
  notificationType    String    @map("notification_type")
  title               String
  body                String    @db.Text
  isRead              Boolean   @default(false) @map("is_read")
  readAt              DateTime? @map("read_at")
  relatedEntityType   String?   @map("related_entity_type")
  relatedEntityId     String?   @map("related_entity_id")
  createdAt           DateTime  @default(now()) @map("created_at")

  recipient           User?     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  logs                NotificationLog[]

  @@index([recipientUserId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
  @@schema("core")
}

model NotificationLog {
  id                  String    @id @default(uuid())
  // Nullable: see comment on Notification.recipientUserId. A log row with no
  // anchoring Notification is allowed for system-emitted messages (rate-limit
  // tracking on anonymous sends, etc.).
  notificationId      String?   @map("notification_id")
  channel             String    // email | sms | whatsapp | inapp
  emailProviderId     String?   @map("email_provider_id")
  whatsappProviderId  String?   @map("whatsapp_provider_id")
  recipientAddress    String    @map("recipient_address")
  status              String    // queued | sent | delivered | failed | read
  sentAt              DateTime? @map("sent_at")
  deliveredAt         DateTime? @map("delivered_at")
  readAt              DateTime? @map("read_at")
  errorMessage        String?   @map("error_message")
  providerMessageId   String?   @map("provider_message_id")

  createdAt           DateTime  @default(now()) @map("created_at")

  notification        Notification?      @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  emailProvider       EmailProvider?     @relation(fields: [emailProviderId], references: [id], onDelete: SetNull)
  whatsappProvider    WhatsappProvider?  @relation(fields: [whatsappProviderId], references: [id], onDelete: SetNull)

  @@index([notificationId])
  @@index([channel])
  @@index([status])
  @@index([providerMessageId])
  @@map("notification_log")
  @@schema("core")
}

