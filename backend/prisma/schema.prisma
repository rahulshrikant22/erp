  materialId            String    @map("material_id")
  sourceLocationId      String?   @map("source_location_id")
  destinationLocationId String?   @map("destination_location_id")
  sourceBinId           String?   @map("source_bin_id")
  destinationBinId      String?   @map("destination_bin_id")
  quantity              Decimal   @db.Decimal(14, 4)
  batchId               String?   @map("batch_id")
  unitCostAtMovement    Decimal?  @map("unit_cost_at_movement") @db.Decimal(14, 4)
  totalCost             Decimal?  @map("total_cost") @db.Decimal(14, 2)
  referenceDocType      String?   @map("reference_doc_type") // grn | min | transfer_note | adjustment_voucher | return_note
  referenceDocId        String?   @map("reference_doc_id")
  movedBy               String?   @map("moved_by")
  movedAt               DateTime  @default(now()) @map("moved_at")
  reason                String?   @db.Text
  notes                 String?   @db.Text

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  material              Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  sourceLocation        StorageLocation?  @relation("MovementSource", fields: [sourceLocationId], references: [id])
  destinationLocation   StorageLocation?  @relation("MovementDest", fields: [destinationLocationId], references: [id])
  sourceBin             StorageBin?       @relation("MovementSourceBin", fields: [sourceBinId], references: [id])
  destinationBin        StorageBin?       @relation("MovementDestBin", fields: [destinationBinId], references: [id])
  batch                 StockBatch?       @relation(fields: [batchId], references: [id])

  @@index([materialId])
  @@index([movementType])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([referenceDocId])
  @@index([movedAt])
