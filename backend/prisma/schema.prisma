  productionJobId  String?   @map("production_job_id")
  nestingRunId     String?   @map("nesting_run_id")
  requestType      String    @default("general") @map("request_type") // production | sample | rework | r_and_d | general
  requestingUserId String?   @map("requesting_user_id")
  requestedAt      DateTime  @default(now()) @map("requested_at")
  requiredByDate   DateTime? @map("required_by_date")
  approvalStatus   String    @default("pending") @map("approval_status") // pending | approved | rejected | auto_approved
  approverUserId   String?   @map("approver_user_id")
  approvedAt       DateTime? @map("approved_at")
  rejectionReason  String?   @map("rejection_reason") @db.Text
  status           String    @default("draft") // draft | submitted | approved | issued | partially_issued | cancelled
  notes            String?   @db.Text

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  lines            MaterialRequisitionLine[]
  issueNotes       MaterialIssueNote[]

  @@index([status])
  @@index([productionJobId])
  @@index([nestingRunId])
  @@index([requestedAt])
  @@map("material_requisitions")
  @@schema("inventory")
}

model MaterialRequisitionLine {
  id                  String    @id @default(uuid())
  mrId                String    @map("mr_id")
  materialId          String    @map("material_id")
  quantityRequired    Decimal   @map("quantity_required") @db.Decimal(14, 4)
  uom                 String    @default("PCS")
  nestingRunLineId    String?   @map("nesting_run_line_id")
  preferredLocationId String?   @map("preferred_location_id")
  issuedQuantity      Decimal   @default(0) @map("issued_quantity") @db.Decimal(14, 4)
  status              String    @default("pending") // pending | partially_issued | fully_issued | cancelled

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  mr                  MaterialRequisition     @relation(fields: [mrId], references: [id], onDelete: Cascade)
  material            Material                @relation(fields: [materialId], references: [id], onDelete: Restrict)
  issueNoteLines      MaterialIssueNoteLine[]

  @@index([mrId])
  @@index([materialId])
  @@map("material_requisition_lines")
  @@schema("inventory")
}

model MaterialIssueNote {
  id                  String    @id @default(uuid())
  minNumber           String    @unique @map("min_number")
  mrId                String    @map("mr_id")
  productionJobId     String?   @map("production_job_id")
  nestingRunId        String?   @map("nesting_run_id")
  issuedFromLocationId String   @map("issued_from_location_id")
  issuedToDestination String?   @map("issued_to_destination")
  issuedBy            String?   @map("issued_by")
  issuedAt            DateTime? @map("issued_at")
  receivedByUserId    String?   @map("received_by_user_id")
  receivedAt          DateTime? @map("received_at")
  status              String    @default("draft") // draft | issued | returned_partial | closed

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  mr                  MaterialRequisition  @relation(fields: [mrId], references: [id], onDelete: Restrict)
  issuedFromLocation  StorageLocation      @relation(fields: [issuedFromLocationId], references: [id])
  lines               MaterialIssueNoteLine[]
  returnNotes         MaterialReturnNote[]

  @@index([mrId])
  @@index([productionJobId])
  @@index([nestingRunId])
  @@index([status])
  @@map("material_issue_notes")
  @@schema("inventory")
}

model MaterialIssueNoteLine {
  id               String    @id @default(uuid())
  minId            String    @map("min_id")
  mrLineId         String    @map("mr_line_id")
  materialId       String    @map("material_id")
  quantityIssued   Decimal   @map("quantity_issued") @db.Decimal(14, 4)
  uom              String    @default("PCS")
  batchId          String?   @map("batch_id")
  unitCost         Decimal?  @map("unit_cost") @db.Decimal(14, 4)
  binId            String?   @map("bin_id")
  nestingRunLineId String?   @map("nesting_run_line_id")
  returnQuantity   Decimal   @default(0) @map("return_quantity") @db.Decimal(14, 4)

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  min              MaterialIssueNote        @relation(fields: [minId], references: [id], onDelete: Cascade)
  mrLine           MaterialRequisitionLine  @relation(fields: [mrLineId], references: [id], onDelete: Restrict)
  material         Material                 @relation(fields: [materialId], references: [id], onDelete: Restrict)
  batch            StockBatch?              @relation(fields: [batchId], references: [id])
  bin              StorageBin?              @relation(fields: [binId], references: [id])
  returnNoteLines  MaterialReturnNoteLine[]

  @@index([minId])
  @@index([mrLineId])
  @@index([materialId])
  @@map("material_issue_note_lines")
  @@schema("inventory")
}

model MaterialReturnNote {
  id                   String    @id @default(uuid())
  mrnNumber            String    @unique @map("mrn_number")
  originalMinId        String    @map("original_min_id")
  productionJobId      String?   @map("production_job_id")
  returnedBy           String?   @map("returned_by")
  returnedAt           DateTime  @default(now()) @map("returned_at")
  receivedAtLocationId String    @map("received_at_location_id")
  receivedByUserId     String?   @map("received_by_user_id")
  reason               String?   // unused | damaged | wrong_material | excess | quality_issue
  notes                String?   @db.Text

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  originalMin          MaterialIssueNote  @relation(fields: [originalMinId], references: [id], onDelete: Restrict)
  receivedAtLocation   StorageLocation    @relation("ReturnReceiveLocation", fields: [receivedAtLocationId], references: [id])
  lines                MaterialReturnNoteLine[]

  @@index([originalMinId])
  @@index([productionJobId])
  @@map("material_return_notes")
  @@schema("inventory")
}

model MaterialReturnNoteLine {
  id                    String    @id @default(uuid())
  mrnId                 String    @map("mrn_id")
  minLineId             String    @map("min_line_id")
  materialId            String    @map("material_id")
  quantityReturned      Decimal   @map("quantity_returned") @db.Decimal(14, 4)
  uom                   String    @default("PCS")
  batchId               String?   @map("batch_id")
  unitCost              Decimal?  @map("unit_cost") @db.Decimal(14, 4)
  condition             String    @default("good_back_to_stock") // good_back_to_stock | damaged_scrap | quarantine_for_review
  destinationLocationId String?   @map("destination_location_id")
  destinationBinId      String?   @map("destination_bin_id")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  mrn                   MaterialReturnNote     @relation(fields: [mrnId], references: [id], onDelete: Cascade)
  minLine               MaterialIssueNoteLine  @relation(fields: [minLineId], references: [id], onDelete: Restrict)
  material              Material               @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([mrnId])
  @@index([minLineId])
  @@map("material_return_note_lines")
  @@schema("inventory")
}

model StockCountSession {
  id               String    @id @default(uuid())
  countNumber      String    @unique @map("count_number")
  countType        String    @map("count_type") // cycle | full | spot
  locationId       String    @map("location_id")
  plannedStartDate DateTime? @map("planned_start_date")
  plannedEndDate   DateTime? @map("planned_end_date")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  status           String    @default("planned") // planned | in_progress | completed | cancelled
  countedByUsers   Json?     @map("counted_by_users")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  location         StorageLocation  @relation(fields: [locationId], references: [id])
  lines            StockCountLine[]

  @@index([locationId])
  @@index([status])
  @@map("stock_count_sessions")
  @@schema("inventory")
}

model StockCountLine {
  id                    String    @id @default(uuid())
  countSessionId        String    @map("count_session_id")
  materialId            String    @map("material_id")
  binId                 String?   @map("bin_id")
  generalAreaId         String?   @map("general_area_id")
  systemQuantity        Decimal   @map("system_quantity") @db.Decimal(14, 4)
  countedQuantity       Decimal?  @map("counted_quantity") @db.Decimal(14, 4)
  variance              Decimal?  @db.Decimal(14, 4)
  varianceReason        String?   @map("variance_reason") @db.Text
  countedBy             String?   @map("counted_by")
  countedAt             DateTime? @map("counted_at")
  recountRequired       Boolean   @default(false) @map("recount_required")
  recountedQuantity     Decimal?  @map("recounted_quantity") @db.Decimal(14, 4)
  adjustmentMovementId  String?   @map("adjustment_movement_id")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  countSession          StockCountSession    @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  material              Material             @relation(fields: [materialId], references: [id], onDelete: Restrict)
  bin                   StorageBin?          @relation(fields: [binId], references: [id])
  generalArea           StorageGeneralArea?  @relation(fields: [generalAreaId], references: [id])

  @@index([countSessionId])
  @@index([materialId])
  @@map("stock_count_lines")
  @@schema("inventory")
}

model StockAdjustment {
  id                  String    @id @default(uuid())
  adjustmentNumber    String    @unique @map("adjustment_number")
  adjustmentType      String    @map("adjustment_type") // count_variance | damage | theft | system_correction | write_off
  requestedBy         String?   @map("requested_by")
  requestedAt         DateTime  @default(now()) @map("requested_at")
  approvedBy          String?   @map("approved_by")
  approvedAt          DateTime? @map("approved_at")
  approvalStatus      String    @default("pending") @map("approval_status") // pending | approved | rejected
  totalValueImpact    Decimal?  @map("total_value_impact") @db.Decimal(14, 2)
  reason              String?   @db.Text
  supportingDocuments Json?     @map("supporting_documents")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  lines               StockAdjustmentLine[]

  @@index([adjustmentType])
  @@index([approvalStatus])
  @@map("stock_adjustments")
  @@schema("inventory")
}

model StockAdjustmentLine {
  id                  String    @id @default(uuid())
  adjustmentId        String    @map("adjustment_id")
  materialId          String    @map("material_id")
  batchId             String?   @map("batch_id")
  locationId          String    @map("location_id")
  binId               String?   @map("bin_id")
  direction           String    // plus | minus
  quantity            Decimal   @db.Decimal(14, 4)
  unitCostUsed        Decimal?  @map("unit_cost_used") @db.Decimal(14, 4)
  lineValueImpact     Decimal?  @map("line_value_impact") @db.Decimal(14, 2)
  resultingMovementId String?   @map("resulting_movement_id")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  adjustment          StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  material            Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
  @@index([materialId])
  @@map("stock_adjustment_lines")
  @@schema("inventory")
}

model ReorderAlert {
  id                       String    @id @default(uuid())
  materialId               String    @map("material_id")
  locationId               String    @map("location_id")
  currentQuantity          Decimal   @map("current_quantity") @db.Decimal(14, 4)
  minThreshold             Decimal   @map("min_threshold") @db.Decimal(14, 4)
  reorderQuantitySuggested Decimal?  @map("reorder_quantity_suggested") @db.Decimal(14, 4)
  alertStatus              String    @default("active") @map("alert_status") // active | acknowledged | pr_raised | closed
  acknowledgedBy           String?   @map("acknowledged_by")
  acknowledgedAt           DateTime? @map("acknowledged_at")
  relatedPrId              String?   @map("related_pr_id")

  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  material                 Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([materialId])
  @@index([alertStatus])
  @@map("reorder_alerts")
  @@schema("inventory")
}

model VendorImportBatch {
  id           String    @id @default(uuid())
  fileName     String    @map("file_name")
  status       String    @default("pending") // pending | processing | completed | failed
  totalRows    Int       @default(0) @map("total_rows")
  successRows  Int       @default(0) @map("success_rows")
  failedRows   Int       @default(0) @map("failed_rows")
  uploadedBy   String?   @map("uploaded_by")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  errors       VendorImportError[]

  @@map("vendor_import_batches")
  @@schema("vendor")
}

model VendorImportError {
  id         String    @id @default(uuid())
  batchId    String    @map("batch_id")
  rowNumber  Int       @map("row_number")
  field      String?
  message    String
  rawData    Json?     @map("raw_data")

  createdAt  DateTime  @default(now()) @map("created_at")

  batch      VendorImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("vendor_import_errors")
  @@schema("vendor")
}
